{
  "name": "smart-rpc-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!@bloxwap/smart-rpc-docs",
    "typecheck": "turbo run typecheck --filter=!@bloxwap/smart-rpc-docs",
    "test": "turbo run test",
    "docs:dev": "pnpm --filter @bloxwap/smart-rpc-docs dev",
    "docs:check": "pnpm --filter @bloxwap/smart-rpc-docs check",
    "docs:build": "pnpm --filter @bloxwap/smart-rpc-docs build",
    "check:rpcs": "node scripts/check-rpcs.mjs",
    "benchmark:core": "pnpm --filter @smart-rpc/core benchmark",
    "rank:hyperevm": "pnpm --filter @smart-rpc/hyperevm rank",
    "changeset": "changeset",
    "benchmark:rpcs": "node scripts/benchmark-rpcs.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "turbo": "^2.5.8",
    "@types/node": "^22.19.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
