{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bloxwap/smart-rpc/blob/main/packages/hyperevm/registry/schema.json",
  "title": "HyperEVM mainnet historical registry ranking",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chainId", "updatedAt", "policy", "endpoints"],
  "properties": {
    "version": { "const": 1 },
    "chainId": { "const": 999 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowMs", "minObservations", "minSpanMs", "minUptime", "minEligibleUptime", "newNodeWeightCap", "maxNewNodeShare"],
      "properties": {
        "windowMs": { "type": "number", "exclusiveMinimum": 0 },
        "minObservations": { "type": "integer", "minimum": 1 },
        "minSpanMs": { "type": "number", "minimum": 0 },
        "minUptime": { "type": "number", "minimum": 0, "maximum": 1 },
        "minEligibleUptime": { "type": "number", "minimum": 0, "maximum": 1 },
        "newNodeWeightCap": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "maxNewNodeShare": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/endpoint" }
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "successes", "uptime", "latencyMs", "tailMs", "medianLag", "established", "precompileOk"],
      "properties": {
        "observations": { "type": "integer", "minimum": 0 },
        "successes": { "type": "integer", "minimum": 0 },
        "uptime": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyMs": { "type": ["number", "null"] },
        "tailMs": { "type": ["number", "null"] },
        "medianLag": { "type": ["number", "null"] },
        "established": { "type": "boolean" },
        "precompileOk": {
          "type": ["boolean", "null"],
          "description": "Latest HyperCore read precompile result. False excludes the endpoint; null means no live-node probe recorded it."
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "eligible", "weight", "rank", "stats"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "eligible": { "type": "boolean" },
        "weight": { "type": "number", "minimum": 0 },
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "stats": { "anyOf": [{ "$ref": "#/$defs/stats" }, { "type": "null" }] }
      }
    }
  }
}
