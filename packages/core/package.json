{
  "name": "@smart-rpc/core",
  "version": "0.1.0",
  "private": true,
  "description": "Private workspace package. Compiled into @bloxwap/smart-rpc. Chain-agnostic routing, failover, scoring, and health checks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark": "tsup --config tsup.benchmark.config.ts && node .dev-dist/benchmark.js"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
