{
  "name": "@smart-rpc/arbitrum",
  "version": "0.1.0",
  "private": true,
  "description": "Private workspace package. Compiled into @bloxwap/smart-rpc/arbitrum.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smart-rpc/core": "workspace:*",
    "@smart-rpc/ethereum": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
